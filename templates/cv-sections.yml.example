# Copy entries under the corresponding section in _data/cv.yml.
# Replace every placeholder before publishing; do not invent dates or credentials.
Education:
  - institution: UNIVERSITY
    area: FIELD
    studyType: DEGREE
    start_date: YYYY-MM
    end_date: YYYY-MM
Experience:
  - company: ORGANIZATION
    position: ROLE
    start_date: YYYY-MM
    end_date: present
    highlights:
      - YOUR_CONTRIBUTION
Skills:
  - name: SKILL_CATEGORY
    keywords: "SKILL_ONE, SKILL_TWO"
